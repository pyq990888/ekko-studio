# Normalize line endings so a Windows checkout with core.autocrlf=true does not
# produce CRLF shell scripts or Node entry points that fail on Linux.
* text=auto eol=lf

# Shell scripts and Node entry points must keep LF even on Windows checkouts.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.node binary
